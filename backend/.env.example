# Copy to backend/.env (git-ignored) and fill in. Never put real values in this file.
DB_HOST=cs-azure.database.windows.net
DB_PORT=1433
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=klongthom-sales
DB_TDS_VERSION=7.4

API_PREFIX=/api
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]

# LINE Login channel ID (not the LIFF ID); enable the LIFF openid scope.
LINE_CHANNEL_ID=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# false only for HTTP local development; always true on Vercel.
SESSION_COOKIE_SECURE=false
SESSION_SECONDS=28800

# true only on local machines — enables POST /api/auth/login-dev
DEV_LOGIN_ENABLED=false
# random string; when set, submissions must carry a valid store QR signature
QR_HMAC_SECRET=
# Vercel Cron sends Authorization: Bearer <CRON_SECRET>; use a separate random secret.
CRON_SECRET=
PHOTO_MAX_BYTES=2097152
PHOTO_RETENTION_DAYS=365
