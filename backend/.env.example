# Copy to backend/.env (git-ignored) and fill in. Never put real values in this file.
DB_HOST=cs-azure.database.windows.net
DB_PORT=1433
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=klongthom-sales
DB_TDS_VERSION=7.4

API_PREFIX=/api
CORS_ORIGINS=["http://localhost:3000","https://klongthom-sales.vercel.app"]

# true only on local machines — enables POST /api/auth/login-dev
DEV_LOGIN_ENABLED=false
# random string; when set, submissions must carry a valid store QR signature
QR_HMAC_SECRET=
