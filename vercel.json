{
  "version": 2,
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "app.html", "use": "@vercel/static" },
    { "src": "support.js", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/app", "dest": "/app.html" },
    { "src": "/index", "dest": "/index.html" },
    {
      "src": "/support.js",
      "headers": { "Cache-Control": "public, max-age=86400" },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "status": 404 }
  ],
  "crons": [
    { "path": "/api/maintenance/photos/cleanup", "schedule": "0 0 * * *" }
  ]
}
