# ─── LINE LIFF ────────────────────────────────────────────────────
# LIFF ID จาก LINE Developers Console (ไม่ใส่ค่าจริงในไฟล์นี้)
LIFF_ID=your-liff-id-here

# LINE Channel Access Token (สำหรับ backend ส่ง push message)
LINE_CHANNEL_ACCESS_TOKEN=your-channel-access-token

# LINE Channel Secret
LINE_CHANNEL_SECRET=your-channel-secret

# ─── DATABASE (เมื่อต่อ backend) ──────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/klongthom

# ─── APP ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
